 "lines": [
  {
   "c": 0,
   "s": "sora",
   "t": "おはようございます。11月24日、火曜日の「毎朝5分ラジオ」です。今日は経済の回です。",
   "start": 0.0,
   "end": 6.83
  },
  {
   "c": 0,
   "s": "hal",
   "t": "おはようございます、解説のハルです。今日は経済の話題を3つと、最後に「世界の1分ニュース」をお届けします。",
   "start": 7.18,
   "end": 13.68
  },
  {
   "c": 1,
   "s": "sora",
   "t": "では早速、1つ目をお願いします。",
   "start": 14.03,
   "end": 16.3
  },
  {
   "c": 1,
   "s": "hal",
   "t": "エヌビディアで、驚きの展開がありました。辞めたばかりの創業者、ジェンスン・フアンさんが、CEOに戻ったんです。",
   "start": 16.65,
   "end": 24.06
  },
  {
   "c": 1,
   "s": "sora",
   "t": "えっ、辞めたばかりなのに、もう戻ったんですか？",
   "start": 24.41,
   "end": 27.48
  },
  {
   "c": 1,
   "s": "hal",
   "t": "そうなんです。ところが日本時間の昨日、取締役会がフアンさんを、すぐにCEOに戻すと決めました。",
   "start": 27.83,
   "end": 36.37
  },
  {
   "c": 1,
   "s": "sora",
   "t": "一度辞めたのは、どうしてだったんでしょう。",
   "start": 36.72,
   "end": 39.22
  },
  {
   "c": 1,
   "s": "hal",
   "t": "個人的な問題をめぐる辞任でした。その経緯についての調査は、まだ続いていると伝えられています。",
   "start": 39.57,
   "end": 45.95
  },
  {
   "c": 1,
   "s": "sora",
   "t": "市場は、どう受け止めたんですか？",
   "start": 46.3,
   "end": 48.58
  },
  {
   "c": 1,
   "s": "hal",
   "t": "エヌビディアの株は、3割ほど値上がりしたと伝えられています。",
   "start": 48.93,
   "end": 52.8
  },
  {
   "c": 1,
   "s": "sora",
   "t": "まさに、どんでん返しですね。",
   "start": 53.15,
   "end": 55.02
  },
  {
   "c": 1,
   "s": "hal",
   "t": "アメリカの株価全体も大きく上がり、代表的な指数は5%前後、ハイテク株の多い指数は6%を超える上昇になりました。",
   "start": 55.37,
   "end": 64.37
  },
  {
   "c": 1,
   "s": "sora",
   "t": "先週は、ずっと下がっていたんですよね。",
   "start": 64.72,
   "end": 67.4
  },
  {
   "c": 1,
   "s": "hal",
   "t": "はい。会計の調査の報道もあって、AIの株が大きく売られていました。その下げの半分以上を、1日で取り戻した形です。",
   "start": 67.75,
   "end": 76.86
  },
  {
   "c": 1,
   "s": "sora",
   "t": "トップが戻るだけで、そんなに変わるんですね。",
   "start": 77.21,
   "end": 79.6
  },
  {
   "c": 1,
   "s": "hal",
   "t": "それだけ、フアンさんの存在が大きいと見られているんです。ただ、会計の調査は続いていて、不安が消えたわけではありません。",
   "start": 79.95,
   "end": 87.13
  },
  {
   "c": 1,
   "s": "sora",
   "t": "しばらくは、目が離せませんね。",
   "start": 87.48,
   "end": 89.52
  },
  {
   "c": 2,
   "s": "sora",
   "t": "2つ目は、何でしょう？",
   "start": 89.87,
   "end": 91.63
  },
  {
   "c": 2,
   "s": "hal",
   "t": "日本の株の話です。先週金曜の日経平均株価は、1日で3000円あまり下がりました。",
   "start": 91.98,
   "end": 98.65
  },
  {
   "c": 2,
   "s": "sora",
   "t": "3000円も！割合にすると、どれくらいですか？",
   "start": 99.0,
   "end": 102.52
  },
  {
   "c": 2,
   "s": "hal",
   "t": "5%ほどです。1日の下げ幅としては、過去5番目の大きさだそうです。",
   "start": 102.87,
   "end": 107.88
  },
  {
   "c": 2,
   "s": "sora",
   "t": "どうして、そんなに下がったんでしょう。",
   "start": 108.23,
   "end": 110.4
  },
  {
   "c": 2,
   "s": "hal",
   "t": "アメリカでAIや半導体の株が急落し、その流れが日本にも来ました。日本にも、半導体に関わる会社がたくさんあるからです。",
   "start": 110.75,
   "end": 119.18
  },
  {
   "c": 2,
   "s": "hal",
   "t": "日経平均は、6月の最高値から2割以上も下がっています。",
   "start": 119.53,
   "end": 123.57
  },
  {
   "c": 2,
   "s": "sora",
   "t": "2割以上というのは、何か意味があるんですか？",
   "start": 123.92,
   "end": 126.93
  },
  {
   "c": 2,
   "s": "hal",
   "t": "一般に、高値から2割以上下がると「弱気相場」と呼ばれます。相場の流れが変わった目安とされるんです。",
   "start": 127.28,
   "end": 134.23
  },
  {
   "c": 2,
   "s": "sora",
   "t": "かなり厳しい状況なんですね。",
   "start": 134.58,
   "end": 136.23
  },
  {
   "c": 2,
   "s": "sora",
   "t": "今日は、連休明けの取引ですね。",
   "start": 136.58,
   "end": 138.74
  },
  {
   "c": 2,
   "s": "hal",
   "t": "はい。アメリカの株が大きく戻したので、東京市場も反発するかが注目されます。",
   "start": 139.09,
   "end": 145.01
  },
  {
   "c": 2,
   "s": "sora",
   "t": "私たちの生活にも、影響はありますか？",
   "start": 145.36,
   "end": 147.92
  },
  {
   "c": 2,
   "s": "hal",
   "t": "株を持っている人や、新しいNISAで投資を始めた人には、気になる動きです。ただ、長い目で見ることも大切です。",
   "start": 148.27,
   "end": 156.24
  },
  {
   "c": 3,
   "s": "sora",
   "t": "3つ目は、AIのお金の流れの話だそうですね。",
   "start": 156.59,
   "end": 159.78
  },
  {
   "c": 3,
   "s": "hal",
   "t": "はい。アンソロピックの上場をきっかけに、AI業界の「お金の回し合い」が話題になっています。",
   "start": 160.13,
   "end": 165.82
  },
  {
   "c": 3,
   "s": "sora",
   "t": "お金の回し合いって、どういうことですか？",
   "start": 166.17,
   "end": 168.45
  },
  {
   "c": 3,
   "s": "hal",
   "t": "例えば、半導体の会社がAIの会社に投資して、そのお金でAIの会社が半導体を買う、という流れです。",
   "start": 168.8,
   "end": 176.77
  },
  {
   "c": 3,
   "s": "sora",
   "t": "それだと、お金がぐるぐる回っているだけに見えますね。",
   "start": 177.12,
   "end": 180.48
  },
  {
   "c": 3,
   "s": "hal",
   "t": "そうなんです。売り上げが伸びて見えても、本当の需要がどれだけあるのか分かりにくい、という指摘があります。",
   "start": 180.83,
   "end": 187.78
  },
  {
   "c": 3,
   "s": "sora",
   "t": "外から見ると、分かりにくいですね。",
   "start": 188.13,
   "end": 190.06
  },
  {
   "c": 3,
   "s": "hal",
   "t": "アメリカのテッククランチは、アンソロピックの上場は、この仕組みが本物かを試す場になると論じています。",
   "start": 190.41,
   "end": 196.56
  },
  {
   "c": 3,
   "s": "sora",
   "t": "株を買う人は、何を見ればいいんでしょう。",
   "start": 196.91,
   "end": 199.47
  },
  {
   "c": 3,
   "s": "hal",
   "t": "AIを使う企業や個人から、実際にどれだけお金が入ってくるかです。そこが、これからの株価を左右しそうです。",
   "start": 199.82,
   "end": 206.66
  },
  {
   "c": 3,
   "s": "sora",
   "t": "日本の会社も、関係していますか？",
   "start": 207.01,
   "end": 209.28
  },
  {
   "c": 3,
   "s": "hal",
   "t": "日本の大手企業も、AIの会社に出資しています。AIの株価が揺れると、そうした企業の株にも影響が出やすくなります。",
   "start": 209.63,
   "end": 217.78
  },
  {
   "c": 4,
   "s": "sora",
   "t": "最後は「世界の1分ニュース」です。",
   "start": 218.13,
   "end": 220.57
  },
  {
   "c": 4,
   "s": "hal",
   "t": "ウクライナで、ロシアによる攻撃が続いています。",
   "start": 220.92,
   "end": 223.65
  },
  {
   "c": 4,
   "s": "hal",
   "t": "ゼレンスキー大統領は、先週1週間で、大量の無人機やミサイルによる攻撃を受けたと明らかにしました。",
   "start": 224.0,
   "end": 231.29
  },
  {
   "c": 4,
   "s": "sora",
   "t": "ウクライナは、何を求めているんですか？",
   "start": 231.64,
   "end": 234.14
  },
  {
   "c": 4,
   "s": "hal",
   "t": "アメリカに対して、防空ミサイル「パトリオット」を早く渡すよう求めています。冬を前に、電力施設への攻撃が心配されています。",
   "start": 234.49,
   "end": 242.52
  },
  {
   "c": 4,
   "s": "sora",
   "t": "電力施設が狙われると、どうなるんですか？",
   "start": 242.88,
   "end": 245.72
  },
  {
   "c": 4,
   "s": "hal",
   "t": "暖房や水道が止まるおそれがあります。寒い冬を、電気なしで過ごさなければならない人も出てきます。",
   "start": 246.07,
   "end": 252.68
  },
  {
   "c": 5,
   "s": "sora",
   "t": "今日のクイズです。株価が高値から2割以上下がった状態を、何と呼ぶでしょう？",
   "start": 253.03,
   "end": 258.21
  },
  {
   "c": 5,
   "s": "hal",
   "t": "答えは、ページの下のクイズで確かめてください。",
   "start": 258.56,
   "end": 261.52
  },
  {
   "c": 5,
   "s": "sora",
   "t": "気になった話題には「興味あり」、いまいちだったら「興味なし」を押してくださいね。",
   "start": 261.87,
   "end": 266.59
  },
  {
   "c": 5,
   "s": "hal",
   "t": "それではまた明日。明日、水曜日は世界ニュース特集の回です。",
   "start": 266.94,
   "end": 271.5
  }
 ],
